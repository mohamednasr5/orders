{
  "rules": {
    "orders": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$orderId": {
        ".validate": "newData.hasChildren(['id', 'customer', 'amount', 'status'])"
      }
    },
    "products": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$productId": {
        ".validate": "newData.hasChildren(['name', 'price', 'stock'])"
      }
    },
    "crm": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$customerId": {
        ".validate": "newData.hasChildren(['name', 'email'])"
      }
    },
    "movements": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "settings": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "analytics": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
