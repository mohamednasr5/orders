{
  "rules": {
    "orders": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$orderId": {
        ".validate": "newData.hasChildren(['id', 'customer', 'amount', 'status'])",
        ".validate": "newData.child('status').val() === 'pending' || newData.child('status').val() === 'processing' || newData.child('status').val() === 'shipped' || newData.child('status').val() === 'delivered' || newData.child('status').val() === 'cancelled'",
        ".validate": "newData.child('amount').isNumber() && newData.child('amount').val() >= 0"
      }
    },
    "products": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$productId": {
        ".validate": "newData.hasChildren(['name', 'price', 'stock'])",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 200",
        ".validate": "newData.child('price').isNumber() && newData.child('price').val() >= 0",
        ".validate": "newData.child('stock').isNumber() && newData.child('stock').val() >= 0"
      }
    },
    "crm": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$customerId": {
        ".validate": "newData.hasChildren(['name', 'email'])",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 100"
      }
    },
    "movements": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$movementId": {
        ".validate": "newData.hasChildren(['productName', 'type', 'quantity', 'date'])",
        ".validate": "newData.child('type').val() === 'in' || newData.child('type').val() === 'out' || newData.child('type').val() === 'adjustment'",
        ".validate": "newData.child('quantity').isNumber() && newData.child('quantity').val() > 0"
      }
    },
    "settings": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "analytics": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
